{
  "app-id": "org.vidyagod.VidyaGod",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.4",
  "sdk": "org.kde.Sdk",
  "command": "VidyaGod",
  "finish-args": [
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "vidyagod-binary",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin",
        "cp ../../build/VidyaGod /app/bin/VidyaGod",
        "cp ../../resources/VidyaGod.png /app/share/icons/VidyaGod.png",
        "cp ../../resources/VidyaGod.desktop /app/share/applications/VidyaGod.desktop"
      ]
    }
  ]
}
