{
  "id": "org.vidyagod.VidyaGod",
  "runtime": "org.kde.Platform",
  "sdk": "org.kde.Sdk",
  "runtime-version": "6.7",
  "command": "VidyaGod",
  "finish-args": [
    "--share=network",
    "--filesystem=home",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "vidyagod-binary",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "file",
          "path": "../build/VidyaGod"
        },
        {
          "type": "file",
          "path": "../resources/VidyaGod.desktop"
        },
        {
          "type": "file",
          "path": "../resources/VidyaGod.png"
        }
      ],
      "build-commands": [
        "install -Dm755 VidyaGod /app/bin/VidyaGod",
        "install -Dm644 VidyaGod.desktop /app/share/applications/VidyaGod.desktop",
        "install -Dm644 VidyaGod.png /app/share/icons/hicolor/256x256/apps/VidyaGod.png"
      ]
    }
  ]
}
