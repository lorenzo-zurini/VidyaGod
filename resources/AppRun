#!/bin/bash
# AppRun script for VidyaGod AppImage

# Set APPDIR if not already set (AppImage sets this automatically)
if [ -z "$APPDIR" ]; then
    export APPDIR="$(dirname "$(readlink -f "$0")")"
fi

# Add bundled binaries to PATH (so fuse-zip can be called)
export PATH="$APPDIR/usr/bin:$PATH"

# Add Qt libraries if necessary (optional, linuxdeployqt usually handles this)
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$LD_LIBRARY_PATH"

# Set locale translations path
export QT_TRANSLATIONS_DIR="$APPDIR/usr/share/locale"

# If called with --shell, drop into an interactive shell
if [[ "$1" == "--shell" ]]; then
    echo "Launching interactive shell inside AppImage..."
    cd "$APPDIR"
    exec bash
fi

# Resolve the directory where this script (AppRun) lives
HERE="$(dirname "$(readlink -f "$0")")"

# Output the path for debugging
echo "AppRun is located in: $HERE"

# Launch the application normally
LD_LIBRARY_PATH="$APPDIR/usr/lib" "$APPDIR/usr/bin/VidyaGod" "$@"
