#!/bin/bash
# AppRun script for VidyaGod AppImage

set -euxo pipefail  # Print each command, exit on errors, undefined vars are errors

# The root of the AppImage
APPDIR="$(dirname "$(readlink -f "$0")")"
export APPDIR

echo "=============================="
echo "APPDIR: $APPDIR"
echo "PATH: $PATH"
echo "LD_LIBRARY_PATH: $LD_LIBRARY_PATH"
echo "Current dir: $(pwd)"
echo "=============================="

# Add AppDir bin to PATH
export PATH="$APPDIR/usr/bin:$PATH"

# Add Qt libraries if necessary (optional, linuxdeployqt usually handles this)
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$LD_LIBRARY_PATH"

# Set locale translations path
export QT_TRANSLATIONS_DIR="$APPDIR/usr/share/locale"

# Optional: drop into an interactive shell for debugging
if [[ "$1" == "--shell" ]]; then
    echo "Launching interactive shell inside AppImage..."
    exec bash
fi

# Run the real app
exec "$APPDIR/usr/bin/VidyaGod" "$@"
